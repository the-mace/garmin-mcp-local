# Copy this file to .env and fill in your own values. Never commit .env.

# Garmin Connect credentials (used only to establish/refresh a local session
# token cache — the token is stored under GARMIN_TOKEN_STORE, not in .env).
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=changeme

# Directory where the garminconnect/garth session token is cached on disk
# after the first successful login, so subsequent runs don't need to
# re-authenticate with email/password. Keep this out of git (see .gitignore).
GARMIN_TOKEN_STORE=./.garminconnect

# Path to the local SQLite cache database.
GARMIN_DB_PATH=./data/garmin.db

# Minimum delay (seconds) enforced between consecutive Garmin API calls.
GARMIN_MIN_REQUEST_INTERVAL_SECONDS=1.5

# Max retry attempts for a single API call before giving up and logging failure.
GARMIN_MAX_RETRIES=5
