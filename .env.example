# Copy this file to .env and fill in your own values. Never commit .env.

# Garmin Connect credentials (used only to establish/refresh a local session
# token cache — the token is stored under GARMIN_TOKEN_STORE, not in .env).
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=changeme

# Directory where the garminconnect/garth session token is cached on disk
# after the first successful login, so subsequent runs don't need to
# re-authenticate with email/password. Keep this out of git (see .gitignore).
GARMIN_TOKEN_STORE=./.garminconnect

# Path to the local SQLite cache database.
GARMIN_DB_PATH=./data/garmin.db

# Minimum delay (seconds) enforced between consecutive Garmin API calls.
GARMIN_MIN_REQUEST_INTERVAL_SECONDS=1.5

# Max retry attempts for a single API call before giving up and logging failure.
GARMIN_MAX_RETRIES=5

# Scheduled syncs re-run the whole sync when a run hits transient Garmin
# errors (5xx, timeouts): this many extra attempts, waiting this long
# before the first (doubling after).
GARMIN_RUN_RETRIES=2
GARMIN_RUN_RETRY_DELAY_SECONDS=300

# Where failure alerts go (a crashed sync/backfill, or the watchdog finding
# a missed/stale/non-success scheduled run). Sent via the local `mail`
# command -- requires outbound mail already configured on this machine
# (e.g. Postfix relaying through your provider's SMTP). Leave unset to
# disable alerting (failures still get logged to logs/*.error.log, just
# nothing pushes them to you).
ALERT_EMAIL_TO=you@example.com

# Garmin Connect Personal API key (official API), created at
# https://connect.garmin.com/app/settings/personalApiToken. When set, it
# serves activities, laps, daily summary, sleep, HRV and body composition;
# GARMIN_EMAIL/GARMIN_PASSWORD are then only used for training readiness,
# training status and race predictions. Keys last at most one year; set the
# expiry date so the watchdog emails a warning 30, 14, 7, 3, 2, 1 and 0 days
# before it (YYYY-MM-DD; leave blank to skip the check).
GARMIN_API_KEY=
GARMIN_API_KEY_EXPIRES=

# Email a plain-text summary of today's data (sleep, HRV, readiness, training
# status, race predictions, daily health, activities, plus yesterday's
# finished totals) after each garmin-mcp-sync run. Sent via the local `mail`
# command like the alerts. Leave blank to disable.
DAILY_SUMMARY_EMAIL=
