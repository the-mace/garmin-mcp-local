<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.garmin-mcp.sync</string>

    <!-- Invokes the venv binary directly: macOS's Documents-folder TCC
         grant lives on the python3.12 binary itself (see the "Scheduling"
         section of the README), so no app-bundle wrapper is needed --
         python3.12 carries its own permission regardless of what invokes
         it. -->
    <key>ProgramArguments</key>
    <array>
        <string>__REPO_ROOT__/.venv/bin/garmin-mcp-sync</string>
    </array>

    <!-- No WorkingDirectory: config resolves all paths independent of cwd
         (see garmin_mcp/config.py), and setting one isn't needed now that
         nothing here goes through /bin/bash. -->

    <!-- Once daily at 06:00 local time. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__REPO_ROOT__/logs/sync.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_ROOT__/logs/sync.error.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
